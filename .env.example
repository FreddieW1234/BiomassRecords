# Frontend (Vite). These are baked in at build time on Render.
# The Connection Lab can override them at runtime without a rebuild.
VITE_API_URL=http://localhost:8787
VITE_API_KEY=dev-key

# API server (run on the machine behind the Cloudflare tunnel)
PORT=8787
API_KEY=dev-key
# Comma-separated browser origins, or * while testing
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
